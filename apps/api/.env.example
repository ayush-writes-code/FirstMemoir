# Server
PORT=3001
NODE_ENV=development

# Database (Neon/Supabase PostgreSQL - replace with your connection string)
DATABASE_URL="postgresql://test_user:test_password@localhost:54320/test_db"

# JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# CORS
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2 Storage
# Account ID found in the R2 Overview page in the Cloudflare dashboard
R2_ACCOUNT_ID=
# Create an R2 API token with Object Read & Write permissions
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: Custom domain or R2.dev public URL for serving public/product assets
# Leave blank if the bucket is fully private
R2_PUBLIC_URL=
