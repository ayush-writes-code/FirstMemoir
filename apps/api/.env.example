# Server
PORT=3001
NODE_ENV=development

# Database (Neon/Supabase PostgreSQL - replace with your connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/weprintit?schema=public"

# JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# CORS
CORS_ORIGIN=http://localhost:3000
