// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// ENUMS
// -----------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PrintOrientation {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PENDING
}

enum UploadStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  LINKED_TO_CART
  FULFILLED
  ARCHIVED
}

enum UploadRetentionStatus {
  UNATTACHED
  CART_ATTACHED
  CHECKOUT_LOCKED
  ORDERED_RETAINED
  FULFILLED
  ELIGIBLE_FOR_RETENTION_POLICY
}

enum CartStatus {
  ACTIVE
  CHECKOUT_STARTED
  CONVERTED
}

enum PrintQualityStatus {
  EXCELLENT
  GOOD
  ACCEPTABLE
  LOW_QUALITY
  NOT_RECOMMENDED
}

enum CartLineItemStatus {
  PENDING
  VALIDATED
  STALE
  CHECKED_OUT
  CONVERTED
}

enum FrameMaterialType {
  FRAME
  MAT
  GLASS
}

enum DiscountType {
  PERCENT
  FLAT
}

// -----------------------------------------
// MODELS
// -----------------------------------------

/// Represents a user in the system (either CUSTOMER or ADMIN)
model User {
  id            String   @id @default(uuid())
  phone_number  String   @unique
  password_hash String?
  first_name    String?
  last_name     String?
  role          UserRole @default(CUSTOMER)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  addresses      Address[]
  orders         Order[]
  uploads        UserUpload[]
  refresh_tokens RefreshToken[]
  audit_logs     AuditLog[]

  @@map("users")
}

/// Stores OTP requests for phone number authentication
model OtpRequest {
  id           String   @id @default(uuid())
  phone_number String
  otp_hash     String
  expires_at   DateTime
  verified     Boolean  @default(false)
  created_at   DateTime @default(now())

  @@index([phone_number, created_at])
  @@map("otp_requests")
}

/// Manages refresh tokens for user authentication sessions
model RefreshToken {
  id         String   @id @default(uuid())
  token_hash String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  revoked    Boolean  @default(false)
  family     String?
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

/// Stores user addresses for shipping
model Address {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  label       String?
  street      String
  city        String
  state       String
  postal_code String
  country     String   @default("India")
  phone       String?
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id])
  @@map("addresses")
}

/// Product categories that can be organized hierarchically
model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  parent_id   String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  image_url   String?
  is_active   Boolean    @default(true)
  sort_order  Int        @default(0)
  created_at  DateTime   @default(now())

  products ProductCategory[]

  @@map("categories")
}

/// Base product definition
model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  base_price  Decimal
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  categories      ProductCategory[]
  images          ProductImage[]
  order_items     OrderItem[]
  options         ProductOption[]
  exclusions      OptionExclusion[]
  cart_line_items CartLineItem[]

  @@map("products")
}

/// Join table for Product and Category many-to-many relationship
model ProductCategory {
  product_id  String
  category_id String
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([product_id, category_id])
  @@map("product_categories")
}

/// Images associated with products
model ProductImage {
  id         String  @id @default(uuid())
  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  file_key   String
  alt_text   String?
  sort_order Int     @default(0)

  @@index([product_id])
  @@map("product_images")
}

/// Materials available for framing (frames, mats, glass types)
model FrameMaterial {
  id             String            @id @default(uuid())
  name           String
  type           FrameMaterialType
  description    String?
  price_modifier Decimal
  max_width      Decimal?
  max_height     Decimal?
  image_url      String?
  is_active      Boolean           @default(true)
  created_at     DateTime          @default(now())

  option_values ProductOptionValue[]

  @@map("frame_materials")
}

/// User orders containing purchased items
model Order {
  id                        String      @id @default(uuid())
  user_id                   String?
  user                      User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  session_id                String?
  cart_id                   String
  cart                      Cart        @relation(fields: [cart_id], references: [id], onDelete: Restrict)
  customer_email            String?
  customer_phone            String?
  status                    OrderStatus @default(PENDING)
  total_amount              Decimal
  subtotal_amount           Decimal?
  shipping_fee              Decimal?
  tax_amount                Decimal?
  discount_amount           Decimal?
  shipping_address_snapshot Json
  razorpay_order_id         String?
  tracking_awb              String?
  notes                     String?
  created_at                DateTime    @default(now())
  updated_at                DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([user_id])
  @@index([session_id])
  @@index([cart_id])
  @@index([status])
  @@map("orders")
}

/// Individual items within an order
model OrderItem {
  id                 String     @id @default(uuid())
  order_id           String
  order              Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id         String
  product            Product    @relation(fields: [product_id], references: [id], onDelete: Restrict)
  upload_id          String
  upload             UserUpload @relation(fields: [upload_id], references: [id], onDelete: Restrict)
  quantity           Int        @default(1)
  unit_price         Decimal
  customization_data Json
  print_asset_url    String?
  created_at         DateTime   @default(now())

  @@index([order_id])
  @@index([upload_id])
  @@map("order_items")
}

/// Payment records for orders
model Payment {
  id                  String        @id @default(uuid())
  order_id            String
  order               Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  razorpay_payment_id String?
  amount              Decimal
  status              PaymentStatus @default(PENDING)
  method              String?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  @@index([order_id])
  @@map("payments")
}

/// Images uploaded by users for printing/framing
model UserUpload {
  id                String                @id @default(uuid())
  user_id           String?
  user              User?                 @relation(fields: [user_id], references: [id], onDelete: SetNull)
  session_id        String? // HttpOnly session identifier for anonymous uploads
  original_filename String
  r2_key            String                @unique
  preview_r2_key    String? // ~800px WebP proxy generated on READY
  mime_type         String
  file_size         Int
  width             Int? // Original image width in pixels
  height            Int? // Original image height in pixels
  status            UploadStatus          @default(UPLOADING)
  retention_status  UploadRetentionStatus @default(UNATTACHED)
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt

  cart_line_items CartLineItem[]
  order_items     OrderItem[]

  @@index([user_id])
  @@index([session_id])
  @@map("user_uploads")
}

/// Discount coupons
model Coupon {
  id               String       @id @default(uuid())
  code             String       @unique
  discount_type    DiscountType
  value            Decimal
  min_order_amount Decimal?
  max_uses         Int?
  current_uses     Int          @default(0)
  is_active        Boolean      @default(true)
  expires_at       DateTime?
  created_at       DateTime     @default(now())

  @@map("coupons")
}

/// Audit logs for admin actions
model AuditLog {
  id          String   @id @default(uuid())
  admin_id    String
  admin       User     @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  action      String
  entity_type String
  entity_id   String
  metadata    Json?
  created_at  DateTime @default(now())

  @@index([admin_id])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

// -----------------------------------------
// PRODUCT OPTIONS (VARIANTS)
// -----------------------------------------

enum OptionInputType {
  SELECT
  RADIO
  BUTTON
  SWATCH
}

enum PriceModifierType {
  FLAT
  PERCENTAGE
}

/// Defines a category of options for a product (e.g., "Size", "Frame")
model ProductOption {
  id          String          @id @default(uuid())
  product_id  String
  product     Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  name        String // e.g., "Size", "Frame", "Orientation"
  input_type  OptionInputType // e.g., SELECT, BUTTON, RADIO, SWATCH
  is_required Boolean         @default(true)
  sort_order  Int             @default(0)

  values ProductOptionValue[]

  @@index([product_id])
  @@map("product_options")
}

/// Defines the specific choices for an option (e.g., "8x10", "Oak Frame")
model ProductOptionValue {
  id        String        @id @default(uuid())
  option_id String
  option    ProductOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  value     String // e.g., "16x20", "Oak"

  // UI Rendering Metadata (e.g., { hex: "#8B4513", swatchUrl: "..." })
  metadata Json?

  // The pricing modifier strategy
  modifier_type  PriceModifierType @default(FLAT)
  price_modifier Decimal           @default(0.0) // Can be amount or percentage

  // Proper relation to global material with SetNull
  global_material_id String?
  global_material    FrameMaterial? @relation(fields: [global_material_id], references: [id], onDelete: SetNull)

  // Inventory tracking for this specific component
  track_inventory Boolean @default(false)
  stock_count     Int     @default(0)

  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  // Relations for exclusions
  exclusions_as_source OptionExclusion[]         @relation("ExclusionSource")
  exclusions_as_target OptionExclusion[]         @relation("ExclusionTarget")
  cart_selections      CartLineItemOptionValue[]

  @@index([option_id])
  @@index([global_material_id])
  @@map("product_option_values")
}

/// Defines explicitly incompatible option values (e.g. "Canvas" + "Glass")
model OptionExclusion {
  id         String  @id @default(uuid())
  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  option_value_1_id String
  option_value_1    ProductOptionValue @relation("ExclusionSource", fields: [option_value_1_id], references: [id], onDelete: Cascade)

  option_value_2_id String
  option_value_2    ProductOptionValue @relation("ExclusionTarget", fields: [option_value_2_id], references: [id], onDelete: Cascade)

  @@unique([option_value_1_id, option_value_2_id])
  @@map("option_exclusions")
}

// -----------------------------------------
// CART
// -----------------------------------------

/// Anonymous or authenticated shopping cart
model Cart {
  id         String     @id @default(uuid())
  user_id    String?
  session_id String?    @unique // HttpOnly session for anonymous carts
  status     CartStatus @default(ACTIVE)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  items  CartLineItem[]
  orders Order[]

  @@index([user_id])
  @@map("carts")
}

/// A single customized product line item in the cart
/// Prices are NEVER stored here. Backend always recalculates from option values.
model CartLineItem {
  id         String             @id @default(uuid())
  cart_id    String
  cart       Cart               @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quantity   Int                @default(1)
  status     CartLineItemStatus @default(PENDING)

  // Selected option values — stored as FK array via join table
  selected_option_values CartLineItemOptionValue[]

  // Image asset reference
  upload_id   String
  upload      UserUpload @relation(fields: [upload_id], references: [id], onDelete: Restrict)
  preview_url String // Served to browser canvas (~800px proxy)

  // Orientation and Crop metadata
  orientation       PrintOrientation
  crop_x            Float // Left edge (normalized 0.0-1.0 in canonical space)
  crop_y            Float // Top edge (normalized 0.0-1.0 in canonical space)
  crop_width        Float // Width of crop window
  crop_height       Float // Height of crop window
  crop_aspect_ratio String // e.g., "8:10", "12:12" — derived from Size option
  rotation          Float            @default(0) // Degrees
  zoom              Float            @default(1.0) // Scale factor

  // Print quality
  effective_dpi        Int
  print_quality_status PrintQualityStatus
  dpi_acknowledged     Boolean            @default(false)

  // Pricing version snapshot — used to detect stale carts
  pricing_version Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cart_id])
  @@index([upload_id])
  @@map("cart_line_items")
}

/// Join table: which ProductOptionValues are selected for a CartLineItem
model CartLineItemOptionValue {
  cart_line_item_id       String
  product_option_value_id String

  cart_line_item CartLineItem       @relation(fields: [cart_line_item_id], references: [id], onDelete: Cascade)
  option_value   ProductOptionValue @relation(fields: [product_option_value_id], references: [id], onDelete: Restrict)

  @@id([cart_line_item_id, product_option_value_id])
  @@map("cart_line_item_option_values")
}

// -----------------------------------------
// SYSTEM CONFIGURATION
// -----------------------------------------

/// Global store settings and configuration state
model StoreSettings {
  id              String   @id @default("default") // Singleton pattern
  pricing_version Int      @default(1)
  updated_at      DateTime @updatedAt

  @@map("store_settings")
}

model WebhookEvent {
  id                String    @id @default(uuid())
  provider          String    @default("razorpay")
  event_id          String    @unique
  event_type        String
  payload           Json
  processing_status String    @default("PENDING")
  received_at       DateTime  @default(now())
  processed_at      DateTime?

  @@map("webhook_events")
}
